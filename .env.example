# CareCircle Environment Configuration Example
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to Git.

# Next.js Server Port
PORT=8080

# Firebase Client Configuration (Safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK Configuration (Server-side ONLY)
# On Google Cloud Run, default application credentials can be auto-discovered.
# Alternatively provide JSON string or individual values:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Transactional Email Service (Resend or SMTP)
EMAIL_SERVICE_PROVIDER=resend # or 'smtp' or 'mock'
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_FROM_EMAIL=CareCircle Notifications <alerts@carecircle.app>

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cron Security Secret for /api/cron/reminders
CRON_SECRET=carecircle_secure_cron_token_change_in_production

# Application URL (for generating email action links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

